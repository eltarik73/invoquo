generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// === AUTH ===

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("user") // "user" | "admin"
  firstName    String?
  lastName     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  tenantId String?

  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// === TENANT ===

model Tenant {
  id               String  @id @default(cuid())
  siret            String  @unique
  siren            String
  companyName      String
  legalForm        String? // EI, EURL, SARL, SAS, SASU
  capital          String?
  address          String
  postalCode       String
  city             String
  country          String  @default("FR")
  vatNumber        String? // TVA intracommunautaire
  apeCode          String?
  insuranceNumber  String? // assurance décennale
  insuranceProvider String?
  insuranceCoverage String?
  rcs              String?
  phone            String?
  email            String?
  website          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // PA
  paProvider       String?   // "pennylane" | etc.
  paAccessToken    String?   // chiffré
  paRefreshToken   String?   // chiffré
  paTokenExpiresAt DateTime?
  paCompanyId      String?   // ID entreprise chez la PA
  paLastSync       DateTime?
  paStatus         String    @default("disconnected") // "connected" | "disconnected" | "error"

  // Settings - Numérotation
  invoicePrefix    String @default("F-")
  quotePrefix      String @default("D-")
  creditNotePrefix String @default("AV-")
  nextInvoiceNum   Int    @default(1)
  nextQuoteNum     Int    @default(1)
  nextCreditNum    Int    @default(1)

  // Settings - Template
  templateId       String @default("classic") // classic, modern, minimal, lateral, bold
  accentColor      String @default("#7c3aed")
  logoUrl          String?
  headerLine1      String?
  headerLine2      String?
  footerLine1      String?
  footerLine2      String?
  footerLine3      String?

  // Settings - Banque
  iban              String?
  bic               String?
  bankName          String?
  bankAccountHolder String?
  showBankOnInvoice Boolean @default(true)

  // Settings - Paiement
  defaultPaymentTerms         String @default("30_days") // a_reception, 30_days, 45_days_end_of_month, 60_days
  defaultLatePenaltyRate      String @default("3x_legal_rate")
  defaultEarlyPaymentDiscount String @default("Néant")

  // Settings - Emails
  emailSubjectTemplate   String?
  emailBodyTemplate      String?
  reminderSubjectTemplate String?
  reminderBodyTemplate   String?
  autoReminder           Boolean @default(false)
  reminderDays           Int     @default(7)

  // Settings - Mentions
  cgvText              String?
  attachCgv            Boolean @default(false)
  vatOnDebits          Boolean @default(false)
  isMemberAssociation  Boolean @default(false)
  isVatExempt          Boolean @default(false) // art. 293 B

  // Embed
  apiKey          String?   @unique // pour les apps hôtes
  apiKeyCreatedAt DateTime?

  // Relations
  users            User[]
  clients          Client[]
  invoices         Invoice[]
  receivedInvoices ReceivedInvoice[]
  quotes           Quote[]
  exports          Export[]
  iscaKey          IscaKey?

  @@index([siren])
}

// === CLIENTS ===

model Client {
  id               String  @id @default(cuid())
  tenantId         String
  tenant           Tenant  @relation(fields: [tenantId], references: [id])
  type             String  @default("company") // "company" | "individual"
  companyName      String?
  firstName        String?
  lastName         String?
  siret            String?
  siren            String?
  vatNumber        String?
  email            String?
  phone            String?
  address          String?
  postalCode       String?
  city             String?
  country          String  @default("FR")
  deliveryAddress    String?
  deliveryPostalCode String?
  deliveryCity       String?
  source           String  @default("direct") // "direct" | "bativio" | "klikgo"
  notes            String?
  paCustomerId     String? // ID chez la PA
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  invoices Invoice[]
  quotes   Quote[]

  @@unique([tenantId, siret])
  @@index([tenantId, createdAt])
}

// === FACTURES ===

model Invoice {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  clientId          String
  client            Client   @relation(fields: [clientId], references: [id])
  invoiceNumber     String   // F-2026-001 (séquentiel, jamais modifiable)
  status            String   @default("draft") // draft, pending, sent, transmitted, accepted, paid, overdue, rejected
  type              String   @default("invoice") // invoice, credit_note, deposit
  date              DateTime
  dueDate           DateTime
  paymentTerms      String   // a_reception, 30_days, etc.
  operationCategory String   // goods, services, mixed
  currency          String   @default("EUR")
  totalHT           Decimal  @db.Decimal(12, 2)
  totalVAT          Decimal  @db.Decimal(12, 2)
  totalTTC          Decimal  @db.Decimal(12, 2)
  discount          Decimal? @db.Decimal(12, 2)
  discountType      String?  // percentage, fixed
  notes             String?
  pdfUrl            String?  // Vercel Blob URL
  facturxUrl        String?  // Factur-X PDF URL
  paInvoiceId       String?  // ID chez la PA
  paStatus          String?  // statut PA (AFNOR)
  paSentAt          DateTime?
  paidAt            DateTime?
  sentAt            DateTime? // envoyé par email au client
  sendCount         Int      @default(0)
  linkedQuoteId     String?
  linkedCreditNoteId String?
  fromQuoteId       String?  // si converti depuis un devis
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  lines InvoiceLine[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, clientId])
  @@index([paInvoiceId])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position    Int
  description String
  quantity    Decimal @db.Decimal(10, 3)
  unitPriceHT Decimal @db.Decimal(12, 2)
  vatRate     Decimal @db.Decimal(5, 2) // 20.00, 10.00, 5.50, 0.00
  totalHT     Decimal @db.Decimal(12, 2)
  totalVAT    Decimal @db.Decimal(12, 2)
  totalTTC    Decimal @db.Decimal(12, 2)
  unit        String? // piece, hour, m2, kg, etc.

  @@index([invoiceId])
}

// === FACTURES REÇUES (PA) ===

model ReceivedInvoice {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  paInvoiceId    String   // ID chez la PA (clé unique pour upsert)
  supplierName   String
  supplierSiret  String?
  invoiceNumber  String?
  date           DateTime?
  dueDate        DateTime?
  totalHT        Decimal? @db.Decimal(12, 2)
  totalTTC       Decimal? @db.Decimal(12, 2)
  currency       String   @default("EUR")
  status         String   @default("pending") // pending, validated, rejected
  paStatus       String?  // statut PA
  pdfUrl         String?
  category       String?  // fournisseur classifié
  notes          String?
  receivedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, paInvoiceId])
  @@index([tenantId, status, receivedAt])
}

// === DEVIS ===

model Quote {
  id                   String   @id @default(cuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id])
  clientId             String
  client               Client   @relation(fields: [clientId], references: [id])
  quoteNumber          String
  status               String   @default("draft") // draft, sent, accepted, rejected, expired
  date                 DateTime
  validUntil           DateTime
  operationCategory    String
  totalHT              Decimal  @db.Decimal(12, 2)
  totalVAT             Decimal  @db.Decimal(12, 2)
  totalTTC             Decimal  @db.Decimal(12, 2)
  notes                String?
  pdfUrl               String?
  convertedToInvoiceId String?
  sentAt               DateTime?
  acceptedAt           DateTime?
  rejectedAt           DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  lines QuoteLine[]

  @@unique([tenantId, quoteNumber])
  @@index([tenantId, status, createdAt])
}

model QuoteLine {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  position    Int
  description String
  quantity    Decimal @db.Decimal(10, 3)
  unitPriceHT Decimal @db.Decimal(12, 2)
  vatRate     Decimal @db.Decimal(5, 2)
  totalHT     Decimal @db.Decimal(12, 2)
  totalVAT    Decimal @db.Decimal(12, 2)
  totalTTC    Decimal @db.Decimal(12, 2)
  unit        String?

  @@index([quoteId])
}

// === EXPORTS ===

model Export {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  type        String   // fec, csv, pdf_report, facturx_archive
  periodStart DateTime
  periodEnd   DateTime
  fileUrl     String?  // Vercel Blob URL
  fileName    String
  fileSize    Int?
  status      String   @default("pending") // pending, processing, completed, failed
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
}

// === ISCA : Cles de signature par tenant ===

model IscaKey {
  id              String    @id @default(cuid())
  tenantId        String    @unique
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  encryptedSecret String
  iv              String
  authTag         String
  createdAt       DateTime  @default(now())
  rotatedAt       DateTime?
}

// === ISCA : Commandes (table signee #1) ===

model IscaCommande {
  id               String   @id @default(cuid())
  tenantId         String
  siret            String
  idInterne        Int
  dateCreation     DateTime @default(now())
  idUtilisateur    String
  idCaisse         String   @default("WEB")
  statut           String
  montantTotalHT   Decimal  @db.Decimal(12, 6)
  montantTotalTTC  Decimal  @db.Decimal(12, 6)
  montantTVA       Decimal  @db.Decimal(12, 6)
  typeOperation    String
  referenceFacture String?
  thehash          String
  createdAt        DateTime @default(now())

  articles  IscaArticle[]
  paiements IscaPaiement[]

  @@unique([siret, idInterne])
  @@index([tenantId, siret, dateCreation])
}

// === ISCA : Articles (table signee #2) ===

model IscaArticle {
  id                   String   @id @default(cuid())
  tenantId             String
  siret                String
  commandeId           String
  commande             IscaCommande @relation(fields: [commandeId], references: [id])
  idInterne            Int
  dateCreation         DateTime @default(now())
  idUtilisateur        String
  nom                  String
  quantite             Decimal  @db.Decimal(10, 6)
  prixInitial          Decimal  @db.Decimal(12, 6)
  tauxTva              Decimal  @db.Decimal(5, 2)
  montantTvaDeductible Decimal  @db.Decimal(12, 6)
  tauxReduction        Decimal  @db.Decimal(5, 2)  @default(0)
  montantReduction     Decimal  @db.Decimal(12, 6) @default(0)
  prixFinalHT          Decimal  @db.Decimal(12, 6)
  prixFinal            Decimal  @db.Decimal(12, 6)
  thehash              String
  createdAt            DateTime @default(now())

  @@unique([siret, idInterne])
  @@index([tenantId, siret])
  @@index([commandeId])
}

// === ISCA : Paiements (table signee #3) ===

model IscaPaiement {
  id             String   @id @default(cuid())
  tenantId       String
  siret          String
  commandeId     String
  commande       IscaCommande @relation(fields: [commandeId], references: [id])
  idInterne      Int
  idUtilisateur  String
  idCaisse       String   @default("WEB")
  typePaiement   String
  datePaiement   DateTime @default(now())
  montantPaye    Decimal  @db.Decimal(12, 6)
  montantVerse   Decimal  @db.Decimal(12, 6)
  thehash        String
  createdAt      DateTime @default(now())

  @@unique([siret, idInterne])
  @@index([tenantId, siret])
  @@index([commandeId])
}

// === ISCA : Clotures automatiques (table signee #4) ===

model IscaFermeture {
  id                      String   @id @default(cuid())
  tenantId                String
  siret                   String
  idInterne               Int
  type                    String
  dateDebut               DateTime
  dateFin                 DateTime
  dateFermeture           DateTime @default(now())
  totalVentes             Decimal  @db.Decimal(12, 6)
  totalAnnulations        Decimal  @db.Decimal(12, 6)
  totalRemboursements     Decimal  @db.Decimal(12, 6)
  totalTVA                Decimal  @db.Decimal(12, 6)
  totalHT                 Decimal  @db.Decimal(12, 6)
  totalTTC                Decimal  @db.Decimal(12, 6)
  nombreTransactions      Int
  grandTotalVentes        Decimal  @db.Decimal(14, 6)
  grandTotalTVA           Decimal  @db.Decimal(14, 6)
  grandTotalTTC           Decimal  @db.Decimal(14, 6)
  grandNombreTransactions Int
  thehash                 String
  createdAt               DateTime @default(now())

  @@unique([siret, idInterne])
  @@unique([siret, type, dateDebut])
  @@index([tenantId, siret, type])
}

// === ISCA : Journal des Evenements Techniques — JET (table signee #5) ===

model IscaTracabilite {
  id                String   @id @default(cuid())
  tenantId          String
  siret             String
  idInterne         Int
  dateEvenement     DateTime @default(now())
  typeEvenement     String
  idUtilisateur     String
  description       String
  idObjetConcerne   String?
  typeObjetConcerne String?
  detailsJson       String?
  thehash           String
  createdAt         DateTime @default(now())

  @@unique([siret, idInterne])
  @@index([tenantId, siret, dateEvenement])
  @@index([typeEvenement])
}
